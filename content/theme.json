  "pairings": [
    {
      "label": "link hover",
      "fg": "ink",
      "bg": "surface",
      "min": 4.5,
      "contexts": "*"
    },
    {
      "label": "button hover",
      "fg": "on-accent",
      "bg": "accent-fill-hover",
      "min": 4.5,
      "contexts": [
        "global"
      ]
    },
    {
      "label": "muted tone on inverse",
      "fg": "ink-inverse-muted",
      "bg": "surface",
      "min": 4.5,
      "contexts": [
        "inverse"
      ]
    },
    {
      "label": "display type on inverse",

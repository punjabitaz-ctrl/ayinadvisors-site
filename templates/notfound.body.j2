{#- 404 (Sprint 6): the AYiN rings, the Primetime line, a way home or to a consultation, and a link to each practice
from content/services.json, so a lost visitor can reach any part of the site. Every link takes the "/" root. -#}
<main id="main" tabindex="-1" class="nf surface-inverse">
  <svg class="nf-rings" viewBox="0 0 1100 1100" aria-hidden="true">
    <g class="spin">
      <circle cx="550" cy="550" r="544"></circle>
      <circle cx="550" cy="550" r="430"></circle>
      <circle cx="550" cy="550" r="316"></circle>
    </g>
    <circle cx="550" cy="550" r="200"></circle>
    <circle cx="550" cy="550" r="90" fill="currentColor" stroke="currentColor" stroke-width="0.8"></circle>
  </svg>
  <div class="nf-inner">
    <span class="eyebrow on-navy center reveal" style="justify-content:center">Off the map</span>
    <div class="code reveal" data-d="1">404</div>
    <h1 class="reveal" data-d="2">You've found a page that's not ready for Primetime.</h1>
    <p class="lead reveal" data-d="2">The page you're looking for has moved, changed name, or isn't ready yet. Let's get you back to clear ground.</p>
    <div class="nf-actions reveal" data-d="3">
      <a href="{{ "index.html"|ru(root)|e }}" class="btn" data-magnetic><span class="btn-label">Back to Home</span><span class="btn-arrow">→</span></a>
      <a href="{{ "Contact.html"|ru(root)|e }}" class="btn-ghost btn on-navy" data-magnetic><span class="btn-label">Book a Consultation</span></a>
    </div>
    <nav class="nf-routes reveal" data-d="3" aria-label="Practices">
      <h2>Or go straight to a practice</h2>
      <ul>
        {%- for p in pillars %}
        <li><a href="{{ (p.stem ~ ".html")|ru(root)|e }}">{{ p.name|e }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</main>

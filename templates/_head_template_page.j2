{#- Head for template-rendered pages (hub, pillar, service, blog, post): the shared meta block, then the page's inline styles. Rules a page does not use are not emitted. -#}
{%- set partnerships = kind == "pillar" and pillar.slug == "partnerships" -%}
<meta name="theme-color" content="#061325" />
<link rel="icon" type="image/svg+xml" href="{{ root }}favicon.svg" />
<link rel="apple-touch-icon" href="{{ root }}apple-touch-icon.png" />
<meta property="og:type" content="{{ "article" if kind == "post" else "website" }}" />
<meta property="og:site_name" content="AYiN Advisors" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content="{{ page.title|e }}" />
<meta property="og:description" content="{{ page.description|e }}" />
<meta property="og:url" content="{{ page.canonical|e }}" />
<meta property="og:image" content="https://ayinadvisors.com/og-image.jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{%- if kind == "post" %}
<meta property="article:published_time" content="{{ post.published|e }}" />
<meta property="article:modified_time" content="{{ post.updated|e }}" />
<meta property="article:author" content="{{ blog.author.name|e }}" />
{%- endif %}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ page.title|e }}" />
<meta name="twitter:description" content="{{ page.description|e }}" />
<meta name="twitter:image" content="https://ayinadvisors.com/og-image.jpg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="{{ root }}assets/styles.css" />
<script>document.documentElement.classList.add('js');</script>
<style>
  .pagehead { position: relative; padding-top: calc(var(--nav-h) + clamp(60px, 9vw, 120px)); padding-bottom: clamp(50px, 7vw, 96px); background: radial-gradient(120% 130% at 78% 0%, var(--field-bg) 0%, var(--surface) 50%, var(--surface) 100%); overflow: hidden; }
  .pagehead .wrap { position: relative; z-index: 2; }
  .pagehead h1 { color: var(--ink); margin: 22px 0 24px; max-width: 20ch; }
  .pagehead .lead { max-width: 52ch; }
  .ph-motif { position: absolute; right: -120px; top: 50%; transform: translateY(-50%); width: 460px; height: 460px; z-index: 1; opacity: 0.6; }
  .ph-motif circle { fill: none; stroke: var(--line-gold); stroke-width: 0.8; }
  .ph-motif .spin { transform-origin: 230px 230px; animation: spin 60s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

{%- if kind == "hub" %}

  /* ---------- PRACTICE CARDS ---------- */
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .svc { display: flex; flex-direction: column; position: relative; padding: clamp(30px, 3.4vw, 48px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background 0.6s var(--ease), transform var(--dur-tilt) var(--ease-out), box-shadow var(--dur-tilt), opacity var(--dur-card); transition-delay: 0s, calc(var(--i, 0) * 0.1s), 0s, calc(var(--i, 0) * 0.1s); }
  .svc::before { content: ""; position: absolute; left: 0; top: 0; height: 2px; width: 0; background: var(--accent-fill); transition: width 0.6s var(--ease); }
  .svc:hover { background: var(--ink); }
  .svc:hover::before { width: 100%; }
  .svc:hover .iris-ico { color: var(--accent-fill-hover); }
  .svc h3 { margin: 4px 0 14px; transition: color 0.5s var(--ease); }
  .svc:hover h3 { color: var(--surface); }
  .svc-buyer { color: var(--ink-muted); max-width: 42ch; transition: color 0.5s var(--ease); }
  .svc:hover .svc-buyer { color: var(--surface); }
  .svc-names { list-style: none; margin: 24px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; align-content: start; gap: 8px; transition: border-color 0.5s var(--ease); }
  .svc-names li { position: relative; padding-left: 20px; font-size: 0.98rem; line-height: 1.5; color: var(--ink); transition: color 0.5s var(--ease); }
  .svc-names li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 10px; height: 1px; background: var(--accent-fill); }
  .svc:hover .svc-names { border-color: var(--line-gold); }
  .svc:hover .svc-names li { color: var(--surface); }
  .svc-arrow { margin-top: auto; padding-top: 30px; display: inline-flex; align-items: center; font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--accent-ink); transition: color 0.5s var(--ease); }
  .svc:hover .svc-arrow { color: var(--accent-fill-hover); }
  .svc-arrow > span { margin-left: 0.7em; }
  /* The card is a five-row subgrid of the card grid (icon, title, line, names, link), so the title blocks, the lists and the
     links line up across the row whatever the title length; browsers without subgrid keep the stacked flex layout. */
  @supports (grid-template-rows: subgrid) {
    .svc-grid { grid-template-rows: repeat(5, auto); }
    .svc { display: grid; grid-template-rows: subgrid; grid-row: span 5; }
    .svc-arrow { align-self: end; justify-self: start; }
  }

  /* ---------- HOW THE PRACTICES FIT TOGETHER ---------- */
  .fit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .fit-title { margin: 20px 0 0; }
  .fit-copy p { color: var(--ink-muted); max-width: 54ch; }
  .fit-copy p + p { margin-top: 1.2em; }
{%- elif kind == "pillar" %}

  /* ---------- WHAT WE DO ---------- */
  .ps-list { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); list-style: none; padding: 0; margin: 0; }
  .ps-list.ps-3 { grid-template-columns: repeat(3, 1fr); }
  .ps-list li { padding: clamp(26px, 3vw, 40px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: transform var(--dur-tilt) var(--ease-out), box-shadow var(--dur-tilt), opacity var(--dur-card); transition-delay: calc(var(--i, 0) * 0.1s); }
  .ps-list h3 { margin: 0 0 12px; }
  .ps-list p { color: var(--ink-muted); max-width: 42ch; margin: 0; }
{%- if pillar.services|selectattr("href", "defined")|list %}
  .ps-list h3 a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .ps-list h3 a:hover { color: var(--accent-ink); border-bottom-color: currentColor; }
{%- endif %}

  /* ---------- HOW WE WORK ---------- */
  .proc-wrap { position: relative; }
  /* One marker row: the step irises sit on the line, which starts at the first iris centre */
  .proc-line { position: absolute; left: 17px; right: 0; top: 17px; height: 1px; background: var(--line); }
  .proc-line .fill { height: 100%; width: 100%; background: linear-gradient(90deg, var(--accent-fill), var(--accent-fill-hover)); }
  .proc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; position: relative; }
  .proc-step .step-iris { background: var(--surface); border-radius: 50%; position: relative; }
  .proc-step .pn { font-family: var(--serif); font-size: 0.9rem; color: var(--accent-ink); letter-spacing: 0.2em; }
  .proc-step h3 { color: var(--ink); margin: 12px 0 14px; font-size: 1.5rem; }
  .proc-step p { color: var(--ink-muted); font-size: 0.96rem; max-width: 30ch; }

  /* ---------- WHO IT IS FOR ---------- */
  .who-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 90px); align-items: center; }
  .who-title { margin: 20px 0 22px; }
  .who-grid .lead { max-width: 40ch; }
  .principle-list { display: flex; flex-direction: column; }
  .principle { display: flex; gap: 22px; padding: 24px 0; border-top: 1px solid var(--line); }
  .principle:last-child { border-bottom: 1px solid var(--line); }
  .principle .pk { font-family: var(--serif); color: var(--accent-ink); font-size: 1.1rem; flex: none; width: 34px; }
  .principle h3 { font-family: var(--sans); font-size: 1.05rem; font-weight: 600; line-height: 1.7; letter-spacing: normal; color: var(--ink); margin-bottom: 6px; }
  .principle p { color: var(--ink-muted); font-size: 0.95rem; }
{%- if partnerships %}

  /* ---------- WHY THE US MARKET (proof band) ---------- */
  .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .globe-stage { position: relative; aspect-ratio: 1; max-width: 520px; margin-inline: auto; width: 100%; }
  .globe-stage svg { width: 100%; height: 100%; overflow: visible; }
  .meridian { fill: none; stroke: var(--line-gold); stroke-width: 0.6; }
  .latitude { fill: none; stroke: var(--line-gold); stroke-width: 0.6; }
  .globe-outer { fill: none; stroke: var(--accent-fill); stroke-width: 0.8; }
  .arc { fill: none; stroke: var(--accent-fill-hover); stroke-width: 1.2; stroke-dasharray: 240; stroke-dashoffset: 240; }
  .why-grid.in .arc { animation: drawArc 2.4s var(--ease) forwards; }
  .why-grid.in .arc.a2 { animation-delay: 0.5s; }
  .why-grid.in .arc.a3 { animation-delay: 1s; }
  @keyframes drawArc { to { stroke-dashoffset: 0; } }
  .node { fill: var(--accent-fill-hover); }
  .node-pulse { fill: none; stroke: var(--accent-fill-hover); transform-origin: center; }
  .why-grid.in .node-pulse { animation: nodePulse 2.6s var(--ease) infinite; }
  @keyframes nodePulse { 0% { r: 4; opacity: 0.9; } 100% { r: 22; opacity: 0; } }
  .dest { fill: var(--accent-fill); }
  .why-stats { display: grid; grid-template-columns: 1fr; gap: 2px; background: var(--line); border: 1px solid var(--line); margin-top: 40px; }
  .why-stat { background: var(--surface); padding: 26px 24px; }
  .why-stat .n { font-family: var(--serif); font-size: clamp(2rem, 3.4vw, 2.9rem); color: var(--ink); line-height: 1; }
  .why-stat .l { font-size: 0.82rem; color: var(--ink-muted); margin-top: 8px; line-height: 1.4; }
  .why-title { margin: 20px 0 22px; font-size: clamp(2.25rem, 5vw + 1rem, 3.75rem); overflow-wrap: break-word; }
{%- endif %}
{%- elif kind == "service" %}

  /* ---------- THE SERVICE DETAIL ---------- */
  .svc-detail { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(30px, 6vw, 90px); padding-block: clamp(56px, 7vw, 96px); border-top: 1px solid var(--line); align-items: start; }
  .svc-detail:first-of-type { border-top: 0; }
  .svc-detail .sd-left { position: sticky; top: 110px; }
  .svc-detail .sd-num { font-family: var(--serif); font-size: clamp(3.4rem, 7vw, 6rem); color: var(--line); line-height: 0.8; }
.sd-num::before { content: attr(data-n); }
  .js .svc-detail:hover .sd-num, .svc-detail.in .sd-num { color: var(--accent-ink); transition: color 0.8s var(--ease); }
  .svc-detail h2 { font-size: clamp(1.9rem, 3.4vw, 2.9rem); margin: 18px 0 0; }
  .svc-detail .tag { display: inline-block; margin-top: 18px; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-ink); border: 1px solid var(--line-gold); padding: 6px 12px; border-radius: 2px; }
  .svc-detail .sd-body p { font-size: 1.12rem; color: var(--ink); max-width: 54ch; margin-bottom: 30px; }
  .deliverables { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .deliverables li { list-style: none; background: var(--surface); padding: 18px 20px; font-size: 0.98rem; display: flex; gap: 12px; align-items: flex-start; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background 0.4s var(--ease), transform var(--dur-tilt) var(--ease-out), box-shadow var(--dur-tilt), opacity var(--dur-card); transition-delay: 0s, calc(var(--i, 0) * 0.1s), 0s, calc(var(--i, 0) * 0.1s); }
  .deliverables li:hover { background: color-mix(in srgb, var(--ink) 4%, var(--surface)); }
  .deliverables li::before { content: "→"; color: var(--accent-ink); font-size: 0.9rem; margin-top: 2px; }

  /* ---------- BREADCRUMB EYEBROW ---------- */
  .pagehead .eyebrow a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .pagehead .eyebrow a:hover { border-bottom-color: currentColor; }

  /* ---------- COMMON QUESTIONS ---------- */
  .faq-list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .faq-item { padding: clamp(26px, 3vw, 40px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .faq-item h3 { margin: 0 0 12px; }
  .faq-item p { color: var(--ink-muted); max-width: 46ch; margin: 0; }
  .faq-item a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .faq-item a:hover { color: var(--accent-ink); border-bottom-color: currentColor; }

  /* ---------- ALSO IN THE PRACTICE ---------- */
  .ps-list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); list-style: none; padding: 0; margin: 0; }
  .ps-list.ps-2 { grid-template-columns: repeat(2, 1fr); }
  .ps-list li { padding: clamp(26px, 3vw, 40px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: transform var(--dur-tilt) var(--ease-out), box-shadow var(--dur-tilt), opacity var(--dur-card); transition-delay: calc(var(--i, 0) * 0.1s); }
  .ps-list h3 { margin: 0 0 12px; }
  .ps-list h3 a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .ps-list h3 a:hover { color: var(--accent-ink); border-bottom-color: currentColor; }
  .ps-list p { color: var(--ink-muted); max-width: 42ch; margin: 0; }
  .back-link { margin-top: clamp(28px, 4vw, 44px); }
  .back-link a { font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--accent-ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); padding-bottom: 2px; }
  .back-link a:hover { border-bottom-color: currentColor; }
{%- elif kind == "blog" %}

  /* ---------- POST LIST ---------- */
  .post-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .post-item { padding: clamp(26px, 3vw, 40px) 0; border-bottom: 1px solid var(--line); display: grid; gap: 10px; max-width: 72ch; }
  .post-item h2 { margin: 0; }
  .post-item h2 a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .post-item h2 a:hover { color: var(--accent-ink); border-bottom-color: currentColor; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--accent-ink); }
  .post-meta time { color: var(--ink-muted); }
  .post-summary { color: var(--ink-muted); margin: 0; max-width: 62ch; }
  .post-empty { color: var(--ink-muted); margin: 0; padding-top: 24px; border-top: 1px solid var(--line); max-width: 62ch; }
{%- elif kind == "post" %}

  /* ---------- BREADCRUMB EYEBROW ---------- */
  .pagehead .eyebrow a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .pagehead .eyebrow a:hover { border-bottom-color: currentColor; }
  .pagehead h1 { max-width: 24ch; }

  /* ---------- ARTICLE ---------- */
  .post { max-width: 70ch; }
  .post-byline { margin: 0 0 clamp(28px, 4vw, 44px); padding-bottom: 18px; border-bottom: 1px solid var(--line); font-size: 0.92rem; color: var(--ink-muted); }
  .post-byline a { color: var(--accent-ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .post-byline a:hover { border-bottom-color: currentColor; }
  .prose { color: var(--ink); font-size: 1.08rem; line-height: 1.75; }
  .prose h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); margin: 1.8em 0 0.6em; color: var(--ink); }
  .prose h2:first-child { margin-top: 0; }
  .prose p { margin: 0 0 1.1em; }
  .prose ul, .prose ol { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose li { margin-bottom: 0.6em; }
  .prose li::marker { color: var(--accent-ink); }
  .prose strong { font-weight: 600; }
  .prose a { color: var(--accent-ink); text-decoration: underline; text-decoration-color: var(--line-gold); text-underline-offset: 3px; }

  /* ---------- RELATED SERVICES ---------- */
  .ps-list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); list-style: none; padding: 0; margin: 0; }
  .ps-list.ps-2 { grid-template-columns: repeat(2, 1fr); }
  .ps-list.ps-1 { grid-template-columns: 1fr; }
  .ps-list li { padding: clamp(26px, 3vw, 40px); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ps-list h3 { margin: 0 0 12px; }
  .ps-list h3 a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); }
  .ps-list h3 a:hover { color: var(--accent-ink); border-bottom-color: currentColor; }
  .ps-list p { color: var(--ink-muted); max-width: 42ch; margin: 0; }
  .back-link { margin-top: clamp(28px, 4vw, 44px); }
  .back-link a { font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--accent-ink); text-decoration: none; border-bottom: 1px solid var(--line-gold); padding-bottom: 2px; }
  .back-link a:hover { border-bottom-color: currentColor; }
{%- endif %}

  /* ---------- CTA ---------- */
  .cta { position: relative; overflow: hidden; }
  .cta-inner { text-align: center; max-width: 780px; margin-inline: auto; position: relative; z-index: 2; }
  .cta h2 { color: var(--ink); margin: 24px 0 26px; }
  .cta .lead { color: var(--ink-muted); margin-inline: auto; }
  .cta-glow { position: absolute; width: 60vw; height: 60vw; max-width: 720px; max-height: 720px; left: calc(50% - min(30vw, 360px)); top: calc(50% - min(30vw, 360px)); background: radial-gradient(circle, var(--gold-glow) 0%, transparent 60%); opacity: 0.5; z-index: 1; pointer-events: none; }

{%- if kind == "hub" %}

  @media (max-width: 880px) {
    .svc-grid, .fit-grid { grid-template-columns: 1fr; }
    .ph-motif { opacity: 0.3; right: -200px; }
  }
{%- elif kind == "pillar" %}

  @media (max-width: 880px) {
    .ps-list.ps-3, .proc-grid, .who-grid{% if partnerships %}, .why-grid{% endif %} { grid-template-columns: 1fr; }
    .proc-line { display: none; }
    .proc-grid { gap: 0; }
    .proc-step { padding: 22px 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr; gap: 20px; }
      .proc-step .step-iris { grid-column: 1; grid-row: 1 / span 3; margin: 0; }
    .proc-step > :is(.pn, h3, p) { grid-column: 2; }
    {%- if partnerships %}
    .why-stats { grid-template-columns: 1fr; }
    {%- endif %}
    .ph-motif { opacity: 0.3; right: -200px; }
  }
  @media (max-width: 640px) {
    .ps-list { grid-template-columns: 1fr; }
  }
{%- elif kind == "service" %}

  @media (max-width: 880px) {
    .ps-list, .ps-list.ps-2 { grid-template-columns: 1fr; }
    .faq-list { grid-template-columns: 1fr; }
    .ph-motif { opacity: 0.3; right: -200px; }
  }
  @media (max-width: 820px) {
    .svc-detail { grid-template-columns: 1fr; gap: 24px; }
    .svc-detail .sd-left { position: static; }
    .deliverables { grid-template-columns: 1fr; }
  }
{%- elif kind in ("blog", "post") %}

  @media (max-width: 880px) {
    {%- if kind == "post" %}
    .ps-list, .ps-list.ps-2 { grid-template-columns: 1fr; }
    {%- endif %}
    .ph-motif { opacity: 0.3; right: -200px; }
  }
{%- endif %}
</style>

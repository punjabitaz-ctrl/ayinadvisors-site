{#- Service page (a sub-service of a pillar): page head (breadcrumb eyebrow back to the pillar, the service name, its summary), the service detail (paragraph and deliverables, content/services.json "detail"), its common questions ("faq"), the other services of the practice, the gold CTA band. -#}
{%- from "_components.j2" import iris_mark, pagehead, cta_band -%}
{%- set d = service.detail -%}
{%- set back = pillar.stem ~ ".html" -%}
{{ pagehead(pillar.name, service.name, service.summary, back, root) }}
<main id="main" tabindex="-1">
<!-- SERVICE DETAIL -->
<section class="section surface-page clip-x" id="detail" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap">
    <article class="svc-detail reveal assemble" data-assemble>
      <div class="sd-left">
        <div class="sd-num" aria-hidden="true" data-n="{{ "%02d"|format(pillar.services.index(service) + 1) }}"></div>
        <span class="tag">{{ d.tag|e }}</span>
      </div>
      <div class="sd-body">
        <p>{{ d.text|e }}</p>
        <ul class="deliverables asm-stage">
          {%- for item in d.deliverables %}
          <li class="asm-card">{{ item|e }}</li>
          {%- endfor %}
        </ul>
      </div>
    </article>
  </div>
</section>

{%- if faq %}

<!-- COMMON QUESTIONS -->
<section class="section surface-alt clip-x" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="sec-head">
      <div class="left">
        <h2 class="h2 reveal" id="faq-title">Common questions</h2>
      </div>
    </div>
    <div class="faq-list">
      {%- for f in faq %}
      <div class="faq-item">
        <h3 class="h3">{{ f.q|e }}</h3>
        <p>{{ f.before|e }}{% if f.post %}<a href="{{ f.post.href|ru(root)|e }}">{{ f.post.question|e }}</a>{{ f.after|e }}{% endif %}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<!-- ALSO IN THE PRACTICE -->
<section class="section surface-page clip-x assemble" id="more" data-assemble>
  <div class="wrap">
    <div class="sec-head">
      <div class="left">
        <h2 class="h2 asm-fade">Also in {{ pillar.name|e }}</h2>
      </div>
    </div>
    {%- set others = pillar.services|rejectattr("slug", "equalto", service.slug)|list %}
    <ul class="ps-list ps-{{ others|length }} asm-stage">
      {%- for s in others %}
      <li class="asm-card">
        <h3 class="h3">{% if s.href %}<a href="{{ s.href|ru(root)|e }}">{{ s.name|e }}</a>{% else %}{{ s.name|e }}{% endif %}</h3>
        <p>{{ s.summary|e }}</p>
      </li>
      {%- endfor %}
    </ul>
    <p class="back-link"><a href="{{ back|ru(root)|e }}">Back to {{ pillar.name|e }}</a></p>
  </div>
</section>

{{ cta_band(pillar.cta, root, pillar.stem) }}
</main>

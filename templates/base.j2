    </div>
    <button class="nav-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</nav>

<div class="mobile-drawer surface-inverse" role="navigation" aria-label="Mobile menu">
  {% for n in site.nav -%}
  <a href="{{ n.href|e }}"{% if n.class %} class="{{ n.class|e }}"{% endif %}>{{ n.label|e }}</a>
  {% endfor -%}
  <a href="{{ page.cta.href|e }}" class="md-cta">{{ page.cta.label|e }}</a>

{#- Services hub: page head, one card per practice, how the practices fit together, the gold CTA band. Copy: content/services.json "hub" and each pillar's hub_line. -#}
{%- from "_components.j2" import iris_mark, iris_ico, ripples, pagehead, cta_band -%}
{{ pagehead(hub.eyebrow, hub.headline, hub.lead) }}
<main id="main" tabindex="-1">
<!-- PRACTICES -->
<section class="section surface-page has-ripples assemble" id="practices" data-assemble>
  {{ ripples() }}
  <div class="wrap">
    <div class="sec-head">
      <div class="left">
        <span class="eyebrow asm-fade">{{ iris_mark() }}{{ hub.choose.eyebrow|e }}</span>
        <h2 class="h2 asm-fade">{{ hub.choose.heading|e }}</h2>
      </div>
      <p class="muted asm-fade" style="max-width:34ch">{{ hub.choose.intro|e }}</p>
    </div>

    <div class="svc-grid asm-stage">
      {%- for p in pillars %}
      <a class="svc asm-card tilt3d" data-tilt href="{{ p.stem|e }}.html">
        {{ iris_ico(p.icon) }}
        <h3 class="h3">{{ p.name|e }}</h3>
        <p class="svc-buyer">{{ p.hub_line|e }}</p>
        <ul class="svc-names">
          {%- for s in p.services %}
          <li>{{ s.name|e }}</li>
          {%- endfor %}
        </ul>
        <span class="svc-arrow">Explore<span aria-hidden="true">→</span></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- HOW THE PRACTICES FIT TOGETHER -->
<section class="section surface-alt" id="fit">
  <div class="wrap">
    <div class="fit-grid">
      <div>
        <span class="eyebrow reveal">{{ iris_mark() }}{{ hub.fit.eyebrow|e }}</span>
        <h2 class="h2 fit-title reveal" data-d="1">{{ hub.fit.heading|e }}</h2>
      </div>
      <div class="fit-copy reveal" data-d="2">
        {%- for para in hub.fit.paragraphs %}
        <p{% if loop.first %} class="lead"{% endif %}>{{ para|e }}</p>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>

{{ cta_band(hub.cta) }}
</main>

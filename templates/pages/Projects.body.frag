<!-- PAGE HEADER -->
<header class="pagehead surface-inverse">
  <svg class="ph-motif" viewBox="0 0 460 460" aria-hidden="true">
    <g class="spin">
      <circle cx="230" cy="230" r="228"></circle>
      <circle cx="230" cy="230" r="170"></circle>
      <circle cx="230" cy="230" r="110"></circle>
    </g>
    <circle cx="230" cy="230" r="50" fill="currentColor" stroke="currentColor" stroke-width="0.8"></circle>
  </svg>
  <div class="wrap">
    <span class="eyebrow on-navy reveal">Our Work</span>
    <h1 class="display reveal" data-d="1">Ventures in motion.</h1>
    <p class="lead reveal" data-d="2">Products and projects we are building — from live in market to actively in development.</p>
  </div>
</header>

<!-- PROJECTS -->
<main class="section surface-page" style="padding-top:clamp(40px,5vw,72px)">
  <div class="wrap">

    <div class="status-legend reveal">
      <div class="sl-item"><span class="dot dot-complete"></span>Completed</div>
      <div class="sl-item"><span class="dot dot-testing"></span>In testing</div>
      <div class="sl-item"><span class="dot dot-dev"></span>In development</div>
    </div>

    <div class="projects-grid">

      <!-- COMPLETED: Thinkers Dilemma — featured full-width -->
      <div class="project-card featured surface-card reveal">
        <div class="card-left">
          <span class="status-badge badge-complete"><span class="badge-dot"></span>Completed</span>
          <div class="project-index" aria-hidden="true">01</div>
          <h2>Thinkers Dilemma</h2>
          <p>A completed venture exploring the tension between strategic thinking and decisive action in business leadership. Taken from concept to market.</p>
          <div class="project-footer">
            <div class="project-tags">
              <span class="ptag">Strategy</span>
              <span class="ptag">Product</span>
            </div>
          </div>
        </div>
        <div class="card-right">
          <ul class="detail-list">
            <li>Concept developed and validated with target audience</li>
            <li>Taken to market and commercially launched</li>
            <li>Full project lifecycle completed</li>
          </ul>
        </div>
      </div>

      <!-- IN TESTING: BizCheck -->
      <div class="project-card navy-card surface-card reveal">
        <span class="status-badge badge-testing"><span class="badge-dot"></span>In Testing</span>
        <div class="project-index" aria-hidden="true">02</div>
        <h2>BizCheck</h2>
        <div><div style="color: var(--ink-muted)">Business ideas are a dime a dozen - is yours worth building?<br />A 10 agent expert panel will pressure test your idea, give you feedback and fill the gaps. Good inputs in, honest verdict out.</div></div>
        <div class="project-footer">
          <div class="project-tags">
            <span class="ptag">Diagnostics</span>
            <span class="ptag">Tool</span>
          </div>
        </div>
      </div>

      <!-- IN DEVELOPMENT: Channel -->
      <div class="project-card surface-card reveal" data-d="1">
        <span class="status-badge badge-dev"><span class="badge-dot"></span>In Development</span>
        <div class="project-index" aria-hidden="true">03</div>
        <h2>Channel</h2>
        <p>72% of channel partners can't connect your product to their customers' needs. Channel* generates AI powered battlecards, talk tracks, and training for every partner tier. Your assets are auto updated for partners the moment your product changes.</p>
        <div class="project-footer">
          <div class="project-tags">
            <span class="ptag">Platform</span>
            <span class="ptag">Channel</span>
          </div>
        </div>
      </div>

      <!-- IN DEVELOPMENT: Trust -->
      <div class="project-card surface-card reveal" data-d="2">
        <span class="status-badge badge-dev"><span class="badge-dot"></span>In Development</span>
        <div class="project-index" aria-hidden="true">04</div>
        <h2>Trust</h2>
        <p>Stop shipping hallucinations. Trust* catches factual errors, unverifiable claims, and compliance risks in AI generated content automatically, before it reaches anyone who matters.</p>
        <div class="project-footer">
          <div class="project-tags">
            <span class="ptag">Framework</span>
            <span class="ptag">B2B</span>
          </div>
        </div>
      </div>

      <!-- IN DEVELOPMENT: SceneCraft -->
      <div class="project-card navy-card surface-card reveal" data-d="3">
        <span class="status-badge badge-dev"><span class="badge-dot"></span>In Development</span>
        <div class="project-index" aria-hidden="true">05</div>
        <h2>SceneCraft</h2>
        <p>Custom VR training costs $50K–$1M and takes 3–6 months to build. SceneCraft lets L&amp;D managers create immersive training scenarios in plain English. No developers. No game engines. No budget shock.</p>
        <div class="project-footer">
          <div class="project-tags">
            <span class="ptag">VR</span>
            <span class="ptag">L&amp;D</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>

<!-- CTA -->
<section class="section cta surface-accent" style="border-top:1px solid var(--line)">
  <div class="cta-glow"></div>
  <div class="wrap">
    <div class="cta-inner">
      <span class="eyebrow on-navy center reveal" style="justify-content:center">Work with us</span>
      <h2 class="h2 reveal" data-d="1" style="margin:24px 0 26px">Interested in what we're building?</h2>
      <p class="lead reveal" data-d="2" style="margin-inline:auto">Get in touch to learn more about our projects or explore how we might work together.</p>
      <div class="reveal" data-d="3" style="margin-top:38px"><a href="Contact.html" class="btn btn-white" data-magnetic="0.4"><span class="btn-label">Book a Consultation</span><span class="btn-arrow">→</span></a></div>
    </div>
  </div>
</section>

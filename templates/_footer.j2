<footer class="footer surface-inverse">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-col">
        <a href="index.html" class="logo" style="margin-bottom:0">
          <svg class="logo-mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="18.5" stroke="#c6a15c" stroke-width="1"></circle>
            <circle cx="20" cy="20" r="11.5" stroke="#c6a15c" stroke-width="1" opacity="0.45"></circle>
            <circle cx="20" cy="20" r="5.4" fill="#c6a15c"></circle>
            <circle cx="20" cy="20" r="2" fill="#061325"></circle>
          </svg>
          <span class="logo-text"><span class="logo-ayin">AY<span class="lc">i</span>N</span><span class="logo-adv">Advisors</span></span>
        </a>
        <p class="footer-tag">{{ site.footer.tagline }}</p>
      </div>
      {% for col in site.footer.columns -%}
      <div class="footer-col"><h2>{{ col.heading|e }}</h2>
        {% for l in col.links -%}
        <a href="{{ l.href|e }}">{{ l.label|e }}</a>
        {% endfor -%}
      </div>
      {% endfor -%}
    </div>
    <div class="footer-bottom">
      <span>© <span data-year></span> {{ site.footer.legal|e }}</span>
      <span>{{ site.footer.strapline|e }}</span>
    </div>
  </div>
</footer>

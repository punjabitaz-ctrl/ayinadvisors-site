<!-- WHAT WE DO -->
<section class="section surface-page clip-x assemble" id="what" data-assemble>
  <div class="wrap">
    <div class="sec-head">
      <div class="left">
        <span class="eyebrow asm-fade"><svg class="iris-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5.2"/><circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/></svg>AI Solutions Development</span>
        <h2 class="h2 asm-fade">Three ways we put AI to work.</h2>
      </div>
      <p class="muted asm-fade" style="max-width:34ch">We start with the problem, not the technology. Sometimes the answer is AI. Sometimes a simpler fix is better. We tell you which.</p>
    </div>

    <ul class="ps-list ps-3 asm-stage">
      <li class="asm-card tilt3d" data-tilt>
        <h3 class="h3">Custom Applications</h3>
        <p>Software built around how your business works, with AI where it helps and plain code where it does not.</p>
      </li>
      <li class="asm-card tilt3d" data-tilt>
        <h3 class="h3">Workflow Automation</h3>
        <p>Repetitive, manual steps handed to automation, so people spend their time on the work that needs judgment.</p>
      </li>
      <li class="asm-card tilt3d" data-tilt>
        <h3 class="h3">Operational Efficiency</h3>
        <p>A close look at where time and effort are lost in your operations, and practical fixes for the biggest gaps.</p>
      </li>
    </ul>
  </div>
</section>


<!-- HOW WE WORK -->
<section class="section surface-alt has-ripples assemble" id="process" data-assemble>
  <svg class="ripples ripples-top ripples-top-l" viewBox="0 0 540 300" aria-hidden="true" focusable="false"><circle cx="270" cy="6" r="40"/><circle cx="270" cy="6" r="80"/><circle cx="270" cy="6" r="125"/><circle cx="270" cy="6" r="170"/><circle cx="270" cy="6" r="215"/><circle cx="270" cy="6" r="260"/><circle class="drop" cx="270" cy="6" r="3.5"/></svg>
  <div class="wrap">

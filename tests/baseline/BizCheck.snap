<script src="assets/site.js"></script>
<script>
(function () {
  /* ── chips ── */
  var chips = document.getElementById('bc-chips');
  var focusInput = document.getElementById('focus_areas');
  function syncFocus() {
    if (!chips || !focusInput) return;
    focusInput.value = [].slice.call(chips.querySelectorAll('.chip.sel'))
      .map(function (c) { return c.getAttribute('data-v'); }).join(', ');
  }
  if (chips) chips.addEventListener('click', function (e) {
    var c = e.target.closest('.chip');
    if (c) { c.classList.toggle('sel'); syncFocus(); }
  });

  /* Posts to our own Pages Function, which verifies the Turnstile token
     server-side before relaying to Formspree. The Formspree URL lives in a
     Pages environment variable, so it is no longer exposed in page source. */
  var BIZCHECK_ENDPOINT = "/api/bizcheck";
  var CONTACT_EMAIL = "hello@ayinadvisors.com";
  var TURNSTILE_SITEKEY = "0x4AAAAAAFBdMMxC7N5y_3Ya";

  var form = document.getElementById('bizcheck-form');
  var errEl = document.getElementById('bc-error');
  var doneEl = document.getElementById('bc-done');
  var widgetId = null;

  function showErr(m) { if (errEl) { errEl.textContent = m; errEl.classList.add('show'); } }
  function done() { form.style.display = 'none'; doneEl.classList.add('show'); }

  /* Rendered explicitly so we keep the widget id. The page stays on screen
     after a failed submit, and Turnstile tokens are single use — without a
     reset the visitor could never retry. */
  window.__bcRenderTurnstile = function () {
    if (widgetId !== null) return;
    widgetId = window.turnstile.render('#bc-turnstile', {
      sitekey: TURNSTILE_SITEKEY,
      action: 'bizcheck',
      theme: 'dark'
    });
  };
  if (window.__bcTurnstileReady) window.__bcRenderTurnstile();

  if (form) form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (errEl) errEl.classList.remove('show');

    var hp = document.getElementById('website_url');
    if (hp && hp.value) { done(); return; }

    var ok = true;
    ['bc_name', 'bc_company', 'bc_email', 'bc_desc'].forEach(function (id) {
      var el = document.getElementById(id);
      if (!el.value.trim()) { el.style.borderColor = '#c0654a'; ok = false; }
      else el.style.borderColor = '';
    });
    var em = document.getElementById('bc_email');
    if (em.value && !/^[^@]+@[^@]+\.[^@]+$/.test(em.value)) { em.style.borderColor = '#c0654a'; ok = false; }
    if (!ok) { showErr('Please complete the highlighted fields.'); return; }

    if (!window.turnstile || !window.turnstile.getResponse(widgetId)) {
      showErr('Please complete the verification check above.');
      return;
    }

    syncFocus();

    var btn = form.querySelector('.btn');
    var lbl = btn && btn.querySelector('.btn-label');
    if (lbl) lbl.textContent = 'Submitting…';
    if (btn) btn.setAttribute('disabled', '');

    function recover(msg) {
      if (btn) btn.removeAttribute('disabled');
      if (lbl) lbl.textContent = 'Submit for Evaluation';
      if (window.turnstile && widgetId !== null) window.turnstile.reset(widgetId);
      showErr(msg);
    }

    fetch(BIZCHECK_ENDPOINT, { method: 'POST', body: new FormData(form) })
      .then(function (r) {
        if (r.ok) { done(); return; }
        recover(r.status === 403
          ? 'Verification failed. Please complete the check and try again.'
          : 'Something went wrong. Please email ' + CONTACT_EMAIL + ' directly.');
      })
      .catch(function () {
        recover('Something went wrong. Please email ' + CONTACT_EMAIL + ' directly.');
      });
  });

  /* ── second iris canvas for the intake section ── */
  var c2 = document.getElementById('iris2');
  if (c2 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var ctx = c2.getContext('2d'), W, H, cx, cy, R, dpr, t = 0, GOLD = '198,161,92';
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      var r = c2.getBoundingClientRect();
      W = r.width; H = r.height;
      c2.width = W * dpr; c2.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = W / 2; cy = H / 2; R = Math.min(W, H) * 0.38;
    }
    function draw() {
      t++;
      ctx.clearRect(0, 0, W, H);
      for (var i = 1; i <= 5; i++) {
        ctx.beginPath(); ctx.arc(cx, cy, R * i / 5, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(' + GOLD + ',' + (0.04 + i / 5 * 0.08) + ')';
        ctx.lineWidth = 1; ctx.stroke();
      }
      ctx.save(); ctx.translate(cx, cy); ctx.rotate(t * 0.0007);
      ctx.beginPath(); ctx.arc(0, 0, R * 0.7, 0, Math.PI * 2);
      ctx.setLineDash([2, 12]); ctx.strokeStyle = 'rgba(' + GOLD + ',0.35)';
      ctx.lineWidth = 1; ctx.stroke(); ctx.setLineDash([]); ctx.restore();
      if (ctx.createConicGradient) {
        var g = ctx.createConicGradient(t * 0.01, cx, cy);
        g.addColorStop(0, 'rgba(' + GOLD + ',0)');
        g.addColorStop(0.06, 'rgba(' + GOLD + ',0.18)');
        g.addColorStop(0.11, 'rgba(' + GOLD + ',0)');
        g.addColorStop(1, 'rgba(' + GOLD + ',0)');
        ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2);
        ctx.fillStyle = g; ctx.fill();
      }
      requestAnimationFrame(draw);
    }
    new ResizeObserver(resize).observe(c2);
    resize(); requestAnimationFrame(draw);
  }
})();
</script>
</body>
</html>

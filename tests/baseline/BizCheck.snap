<!-- ===================== HERO ===================== -->
<header class="bc-hero">
  <canvas id="iris"></canvas>
  <div class="wrap bc-grid">
    <div>
      <span class="tag-pill reveal">An AYiN Advisors Evaluation System</span>
      <h1 class="display reveal" data-d="1">Your friends say it's a great idea.</h1>
      <div class="bc-tagline reveal" data-d="2">Let's find out if they're right.</div>
      <p class="lead reveal" data-d="3">A ten-agent expert panel evaluates your business idea the way a real advisory firm would. They review capital, demand, operations and risk — and return a single verdict: <strong>GO, CONDITIONAL GO,</strong> or <strong>NO GO</strong>. Before you spend a year finding out the hard way.</p>
      <div class="bc-actions reveal" data-d="4">
        <a href="#submit" class="btn" data-magnetic="0.4"><span class="btn-label">Submit Your Idea</span><span class="btn-arrow">→</span></a>
        <a href="#how" class="btn-ghost" data-magnetic="0.3"><span class="btn-label">How It Works</span></a>
      </div>
    </div>
    <div class="reveal" data-d="2">
      <div class="report-card">
        <div class="rc-top">
          <div class="rc-brand"><span>AYiN Advisors</span> · BizCheck</div>
          <div class="rc-scan">Rapid Scan</div>
        </div>
        <div class="rc-label">Panel Scores</div>
        <div class="score-row"><span class="score-name">The Sales Director</span><span class="score-val hi">7.5</span></div>
        <div class="score-row"><span class="score-name">The Operator</span><span class="score-val hi">7.0</span></div>
        <div class="score-row"><span class="score-name">The CFO</span><span class="score-val">6.0</span></div>
        <div class="score-row"><span class="score-name">The VC</span><span class="score-val lo">5.5</span></div>
        <div class="score-row"><span class="score-name">The Channel Strategist</span><span class="score-val hi">7.8</span></div>
        <div class="rc-div"></div>
        <div class="rc-overall"><span class="l">Overall</span><span class="n">6.8</span></div>
        <div class="verdict-badge"><span class="vl">Panel Verdict</span><span class="vv">Conditional Go</span></div>
      </div>
    </div>
  </div>
</header>

<!-- ===================== HOW IT WORKS ===================== -->
<section class="section paper" id="how">
  <div class="wrap">
    <div class="bc-head">
      <div class="left">
        <span class="eyebrow reveal">The Process</span>
        <h2 class="h2 reveal" data-d="1">Submit once.<br />Ten experts evaluate.</h2>
      </div>
      <p class="lead muted right reveal" data-d="2">Fast, honest and structured — the kind of pressure test that saves founders months of misdirected effort.</p>
    </div>
    <div class="bc-steps">
      <div class="bc-step reveal">
        <div class="n">01</div>
        <h3 class="h3">Describe your idea</h3>
        <p>Fill out a focused brief: what your business does, who it serves, your stage and market. No deck required.</p>
      </div>
      <div class="bc-step reveal" data-d="1">
        <div class="n">02</div>
        <h3 class="h3">Panel evaluates</h3>
        <p>Ten specialist agents review your submission across capital, demand, operations, channels and risk — independently.</p>
      </div>
      <div class="bc-step reveal" data-d="2">
        <div class="n">03</div>
        <h3 class="h3">Receive your verdict</h3>
        <p>A structured report with each panelist's score, their key concerns, and a single aggregate verdict with findings.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== THE PANEL ===================== -->
<section class="section navy" id="panel">
  <div class="wrap">
    <div class="bc-head">
      <div class="left">
        <span class="eyebrow on-navy reveal">The Evaluators</span>
        <h2 class="h2 reveal" data-d="1" style="color:var(--cream)">Ten perspectives.<br />One verdict.</h2>
      </div>
      <p class="lead right reveal" data-d="2" style="color:rgba(247,243,234,0.6)">Each agent specialises in a distinct dimension of business viability — and none of them pull punches.</p>
    </div>
    <div class="panel-grid reveal" data-d="1">
      <div class="pm"><div class="pm-n">01</div><div class="pm-t">The Sales Director</div><div class="pm-f">Revenue potential, channel velocity &amp; sales-cycle realism</div></div>
      <div class="pm"><div class="pm-n">02</div><div class="pm-t">The Operator</div><div class="pm-f">Execution feasibility, operational risk &amp; team readiness</div></div>
      <div class="pm"><div class="pm-n">03</div><div class="pm-t">The CFO</div><div class="pm-f">Unit economics, burn rate &amp; path to profitability</div></div>
      <div class="pm"><div class="pm-n">04</div><div class="pm-t">The VC</div><div class="pm-f">Scalability, defensibility &amp; investment thesis strength</div></div>
      <div class="pm"><div class="pm-n">05</div><div class="pm-t">The Marketing Director</div><div class="pm-f">Brand clarity, customer acquisition &amp; demand generation</div></div>
      <div class="pm"><div class="pm-n">06</div><div class="pm-t">The Channel Strategist</div><div class="pm-f">Distribution fit, partner economics &amp; route to market</div></div>
      <div class="pm"><div class="pm-n">07</div><div class="pm-t">The Legal Advisor</div><div class="pm-f">Regulatory risk, IP exposure &amp; compliance landscape</div></div>
      <div class="pm"><div class="pm-n">08</div><div class="pm-t">The Market Analyst</div><div class="pm-f">Competitive density, market timing &amp; addressable size</div></div>
      <div class="pm"><div class="pm-n">09</div><div class="pm-t">The Customer Advocate</div><div class="pm-f">Product-market fit signals, retention risk &amp; buyer psychology</div></div>
      <div class="pm"><div class="pm-n">10</div><div class="pm-t">The Product Director</div><div class="pm-f">Product clarity, differentiation &amp; build-vs-buy logic</div></div>
    </div>
  </div>
</section>

<!-- ===================== SAMPLE OUTPUT ===================== -->
<section class="section paper" id="sample">
  <div class="wrap">
    <div class="bc-head">
      <div class="left">
        <span class="eyebrow reveal">Sample Output</span>
        <h2 class="h2 reveal" data-d="1">What you receive.</h2>
      </div>
      <p class="lead muted right reveal" data-d="2">A structured score from each panelist, their top concerns, and a clear aggregate verdict — not a list of platitudes.</p>
    </div>
    <div class="sample-grid">
      <div class="reveal">
        <h3 class="h3" style="margin-bottom:22px">The three possible outcomes</h3>
        <div style="border:1px solid var(--line);border-radius:2px;overflow:hidden">
          <div class="outcome">
            <div class="ol">Go</div>
            <div class="ot">Clear to proceed.</div>
            <p>The panel sees credible demand, a workable model and acceptable risk. A strong signal to invest the next phase of effort.</p>
          </div>
          <div class="outcome mid">
            <div class="ol">Conditional Go</div>
            <div class="ot">Proceed — but fix these first.</div>
            <p>The idea has real merit, but specific gaps in model, channel or execution must be addressed before committing capital.</p>
          </div>
          <div class="outcome no">
            <div class="ol">No Go</div>
            <div class="ot">Don't proceed as defined.</div>
            <p>The panel has identified structural obstacles — market, model or competition — that make the current approach unlikely to succeed.</p>
          </div>
        </div>
      </div>
      <div class="reveal" data-d="1">
        <div style="font-size:.6rem;font-weight:700;letter-spacing:.26em;color:var(--slate);text-align:center;margin-bottom:14px;text-transform:uppercase">Sample Report</div>
        <div class="sample-report">
          <div class="rc-top">
            <div class="rc-brand"><span>AYiN Advisors</span> · BizCheck</div>
            <div class="rc-scan">Rapid Scan</div>
          </div>
          <div class="rc-label">Panel Scores</div>
          <div class="fs-row"><span class="fs-n">Sales Director</span><span class="fs-bar"><i style="width:75%"></i></span><span class="fs-v">7.5</span></div>
          <div class="fs-row"><span class="fs-n">Operator</span><span class="fs-bar"><i style="width:70%"></i></span><span class="fs-v">7.0</span></div>
          <div class="fs-row"><span class="fs-n">CFO</span><span class="fs-bar"><i style="width:60%"></i></span><span class="fs-v">6.0</span></div>
          <div class="fs-row"><span class="fs-n">VC</span><span class="fs-bar"><i style="width:55%"></i></span><span class="fs-v">5.5</span></div>
          <div class="fs-row"><span class="fs-n">Marketing Director</span><span class="fs-bar"><i style="width:80%"></i></span><span class="fs-v">8.0</span></div>
          <div class="fs-row"><span class="fs-n">Channel Strategist</span><span class="fs-bar"><i style="width:78%"></i></span><span class="fs-v">7.8</span></div>
          <div class="fs-row"><span class="fs-n">Legal Advisor</span><span class="fs-bar"><i style="width:85%"></i></span><span class="fs-v">8.5</span></div>
          <div class="fs-row"><span class="fs-n">Market Analyst</span><span class="fs-bar"><i style="width:65%"></i></span><span class="fs-v">6.5</span></div>
          <div class="fs-row"><span class="fs-n">Customer Advocate</span><span class="fs-bar"><i style="width:72%"></i></span><span class="fs-v">7.2</span></div>
          <div class="fs-row"><span class="fs-n">Product Director</span><span class="fs-bar"><i style="width:68%"></i></span><span class="fs-v">6.8</span></div>
          <div class="rc-div"></div>
          <div class="rc-overall"><span class="l">Overall Score</span><span class="n">7.1 / 10</span></div>
          <div class="verdict-row">
            <div class="vo"><span class="l">Go</span><span class="v">Clear</span></div>
            <div class="vo on"><span class="l">Conditional Go ✓</span><span class="v">Proceed with fixes</span></div>
            <div class="vo"><span class="l">No Go</span><span class="v">Blocked</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== INTAKE ===================== -->
<section class="section navy intake" id="submit">
  <canvas id="iris2"></canvas>
  <div class="wrap">
    <div class="intake-grid">
      <div class="intake-intro">
        <span class="eyebrow on-navy reveal">Submit Your Idea</span>
        <h2 class="h2 reveal" data-d="1">Let the panel<br />read your idea.</h2>
        <p class="lead reveal" data-d="2">Give us the brief. We'll return a candid panel evaluation — the kind of review most founders only get after they've already committed to the wrong path.</p>
        <div class="imeta-list reveal" data-d="3">
          <div class="imeta"><span class="k">Turnaround</span><span class="v">Within 48 hours<small>Business days</small></span></div>
          <div class="imeta"><span class="k">Format</span><span class="v">Structured report<small>Score and findings per panelist</small></span></div>
          <div class="imeta"><span class="k">Obligation</span><span class="v">None<small>A conversation follows if there's a fit</small></span></div>
        </div>
      </div>
      <div class="form-card reveal" data-d="2">
        <form id="bizcheck-form" novalidate>
          <h2>Request a BizCheck</h2>
          <p class="sub">The brief that powers the panel — takes about three minutes.</p>
          <div class="hp" aria-hidden="true"><label for="website_url">Leave blank</label><input id="website_url" name="_gotcha" type="text" tabindex="-1" autocomplete="off" /></div>
          <input type="hidden" id="focus_areas" name="focus_areas" value="" />
          <input type="hidden" name="_subject" value="BizCheck submission — AYiN Advisors" />
          <div class="field-row">
            <div class="field"><label for="bc_name">Full name</label><input id="bc_name" name="name" type="text" placeholder="Your name" required /></div>
            <div class="field"><label for="bc_company">Company / startup</label><input id="bc_company" name="company" type="text" placeholder="Name or working title" required /></div>
          </div>
          <div class="field-row">
            <div class="field"><label for="bc_email">Work email</label><input id="bc_email" name="email" type="email" placeholder="you@company.com" required /></div>
            <div class="field"><label for="bc_hq">Based in</label><input id="bc_hq" name="hq" type="text" placeholder="Country / region" /></div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="bc_stage">Stage</label>
              <select id="bc_stage" name="stage">
                <option value="" disabled selected>Select stage…</option>
                <option value="Idea">Idea stage</option>
                <option value="MVP">MVP / prototype</option>
                <option value="Early Revenue">Early revenue</option>
                <option value="Growth">Growth / scaling</option>
              </select>
            </div>
            <div class="field"><label for="bc_industry">Industry / sector</label><input id="bc_industry" name="industry" type="text" placeholder="e.g. B2B SaaS, logistics…" /></div>
          </div>
          <div class="field">
            <label for="bc_desc">Describe your business idea</label>
            <textarea id="bc_desc" name="description" placeholder="What does it do, who does it serve, what problem does it solve — and why now?" required></textarea>
          </div>
          <div class="field">
            <label>Primary evaluation focus</label>
            <div class="chips" id="bc-chips">
              <button type="button" class="chip" data-v="Market Fit">Market Fit</button>
              <button type="button" class="chip" data-v="Financial Model">Financial Model</button>
              <button type="button" class="chip" data-v="Channel Access">Channel Access</button>
              <button type="button" class="chip" data-v="Competition">Competition</button>
              <button type="button" class="chip" data-v="Regulatory Risk">Regulatory Risk</button>
            </div>
          </div>
          <div id="bc-turnstile" class="bc-turnstile"></div>
          <p class="form-error" id="bc-error" role="alert"></p>
          <button type="submit" class="btn" data-magnetic="0.25"><span class="btn-label">Submit for Evaluation</span><span class="btn-arrow">→</span></button>
        </form>
        <div class="form-done" id="bc-done">
          <svg viewBox="0 0 80 80" aria-hidden="true"><circle cx="40" cy="40" r="36"></circle><path d="M25 41l11 11 20-22"></path></svg>
          <h2>Submission received.</h2>
          <p>The panel is reviewing your idea. You'll hear from us within 48 business hours.</p>
        </div>
      </div>
    </div>
  </div>
</section>

